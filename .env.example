# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=<broker-host>:9092
KAFKA_TOPIC=lifesigns.ppg.raw
KAFKA_GROUP_ID=lifesigns-vitals-consumer

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://<mongo-host>:27017
MONGO_DB=vitals_db
MONGO_COLLECTION=ppg_vitals_results

# ── Facility ───────────────────────────────────────────────────────────────────
FACILITY_ID=<facility-code>
LOG_LEVEL=INFO

# ── Alert thresholds (defaults shown — override only if clinically required) ───
# Per-packet mismatch: NISO204 device BP vs AI raw (mmHg)
BP_MISMATCH_THRESHOLD_SBP=10
BP_MISMATCH_THRESHOLD_DBP=10

# Session-to-session trend alert (mmHg)
BP_TREND_THRESHOLD_SBP=15
BP_TREND_THRESHOLD_DBP=15

# LS06 second-reading confirm tolerance (mmHg)
LS06_CONFIRM_TOLERANCE=5
